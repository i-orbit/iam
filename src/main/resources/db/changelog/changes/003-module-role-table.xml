<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-role-table" author="inmaytide" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
        <createTable tableName="t_role" remarks="用户角色">
            <column name="id" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(32)" remarks="所属租户"/>
            <column name="code" type="varchar(64)" remarks="角色编码"/>
            <column name="name" type="varchar(64)" remarks="角色名称"/>
            <column name="description" type="varchar(256)" remarks="角色描述"/>
            <column name="status" type="int" remarks="启用状态"/>
            <column name="created_by" type="varchar(32)" remarks="创建人"/>
            <column name="created_at" type="timestamp" defaultValueDate="now()" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(32)" remarks="更新人"/>
            <column name="updated_at" type="timestamp" defaultValueDate="now()" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0" remarks="版本号">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="int" defaultValueNumeric="0" remarks="逻辑删除">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="t_permission" remarks="权限配置">
            <column name="id" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="module_id" type="varchar(32)" remarks="功能模块ID"/>
            <column name="menu_id" type="varchar(32)" remarks="功能菜单ID"/>
            <column name="code" type="varchar(64)" remarks="权限编码"/>
            <column name="name" type="varchar(64)" remarks="权限名称"/>
            <column name="type" type="varchar(32)" remarks="权限类型(BUTTON/API)"/>
            <column name="description" type="varchar(64)" remarks="权限描述"/>
            <column name="status" type="int" remarks="启用状态"/>
            <column name="created_by" type="varchar(32)" remarks="创建人"/>
            <column name="created_at" type="timestamp" defaultValueDate="now()" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(32)" remarks="更新人"/>
            <column name="updated_at" type="timestamp" defaultValueDate="now()" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0" remarks="版本号">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="int" defaultValueNumeric="0" remarks="逻辑删除">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="t_role_menu" remarks="角色菜单">
            <column name="role_id" type="varchar(32)" remarks="角色ID"/>
            <column name="menu_id" type="varchar(32)" remarks="菜单ID"/>
        </createTable>
        <createTable tableName="t_role_permission" remarks="角色权限">
            <column name="role_id" type="varchar(32)" remarks="角色ID"/>
            <column name="permission_id" type="varchar(32)" remarks="权限ID"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
