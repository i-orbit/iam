<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user-table" author="inmaytide" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
        <createTable tableName="t_user" remarks="用户表">
            <column name="id" type="varchar(64)" remarks="主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(64)" remarks="所属租户"/>
            <column name="employee_number" type="varchar(64)" remarks="员工编号"/>
            <column name="username" type="varchar(64)" remarks="用户名">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="varchar(128)" remarks="密码">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(64)" remarks="姓名"/>
            <column name="avatar" type="varchar(512)" remarks="头像"/>
            <column name="gender" type="varchar(32)" remarks="性别"/>
            <column name="birthday" type="timestamp" remarks="生日"/>
            <column name="email" type="varchar(128)" remarks="邮箱"/>
            <column name="phone" type="varchar(32)" remarks="手机号"/>
            <column name="status" type="int" remarks="状态"/>
            <column name="remark" type="varchar(512)" remarks="备注"/>
            <column name="hired_at" type="timestamp" remarks="入职时间"/>
            <column name="regularized_at" type="timestamp" remarks="转正时间"/>
            <column name="terminated_at" type="timestamp" remarks="离职时间"/>
            <column name="employment_status" type="varchar(32)" defaultValue="ACTIVE" remarks="人事状态"/>
            <column name="created_by" type="varchar(64)" remarks="创建人"/>
            <column name="created_at" type="timestamp" defaultValueDate="now()" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(64)" remarks="更新人"/>
            <column name="updated_at" type="timestamp" defaultValueDate="now()" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0" remarks="版本号">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="int" defaultValueNumeric="0" remarks="逻辑删除">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-init-admin-user" author="inmaytide" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM `t_user` WHERE username = 'admin'</sqlCheck>
        </preConditions>
        <insert tableName="t_user">
            <column name="id" value="9999"/>
            <column name="username" value="admin"/>
            <column name="password" value="$2b$10$Tk3AUXgJNZmTClCewJBEneh.ujR0xJwGYBXJYcAsg0Timsjo/Zbki"/>
            <column name="name" value="系统管理员"/>
            <column name="status" value="2"/>
            <column name="employment_status" value="ACTIVE"/>
            <column name="created_by" value="9999"/>
            <column name="updated_by" value="9999"/>
        </insert>
    </changeSet>

    <changeSet id="003-create-table-user-relations" author="inmaytide">
        <createTable tableName="t_user_organization" remarks="用户组织表">
            <column name="user_id" type="varchar(64)" remarks="用户ID"/>
            <column name="organization_id" type="varchar(64)" remarks="组织ID"/>
            <column name="defaulted" type="int" remarks="是否是默认组织"/>
        </createTable>
        <addPrimaryKey tableName="t_user_organization" columnNames="user_id, organization_id"/>
        <createTable tableName="t_user_position" remarks="用户岗位表">
            <column name="user_id" type="varchar(64)" remarks="用户ID"/>
            <column name="position_id" type="varchar(64)" remarks="岗位ID"/>
            <column name="defaulted" type="int" remarks="是否是默认岗位"/>
        </createTable>
        <addPrimaryKey tableName="t_user_position" columnNames="user_id, position_id"/>
        <createTable tableName="t_user_role" remarks="用户角色表">
            <column name="user_id" type="varchar(64)" remarks="用户ID"/>
            <column name="role_id" type="varchar(64)" remarks="角色ID"/>
        </createTable>
        <addPrimaryKey tableName="t_user_role" columnNames="user_id, role_id"/>
    </changeSet>

</databaseChangeLog>
